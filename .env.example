# Copy to .env (never committed) and adjust:  cp .env.example .env

# Folder containing your datasets. It is mounted read-only at the SAME path inside the
# container, so the paths in your datasets YAML work both inside and outside Docker.
DATA_DIR=/path/to/your/datasets

# Optional: Weights & Biases logging (--wandb-project).
WANDB_API_KEY=

# Your user/group ids (run `id -u` and `id -g`), so files created in the container are yours.
UID=1000
GID=1000
